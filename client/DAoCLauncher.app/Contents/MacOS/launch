#!/bin/bash
# DAoCLauncher — runs the DAoC client inside the GUI (Aqua) login session, so the
# game window appears on the desktop instead of inside a terminal's context.
#
#   DAoCLauncher wine <wine-args...>
#
# The 'wine' mode runs the client under the Wine `daoc client install` set up
# (DAOC_WINE_HOME): the rosetta flavour is CrossOver Wine, whose compatdb picks
# mtld3d (D3D9 on Metal) and x87sidecar (the game's x87 math as native ARM64)
# per process; the arm64 flavour is Hadron's arm64 Wine with FEX and mtld3d,
# whose settings `daoc client start` sends on --env. The install sets the
# WINEPREFIX and client directory up; this wrapper only wires the environment
# and execs wine.
set -euo pipefail
INSTALL_DIR="$(cd "$(dirname "$0")/../../../.." && pwd)"   # .../daoc-macos (bundle sits in dist/)
CLIENT_ROOT="$INSTALL_DIR/dist/OfflineDAoC"
WINE_HOME="${DAOC_WINE_HOME:-$INSTALL_DIR/dist/wine}"   # daoc client start passes the installed one

MODE="${1:-}"
[ -z "$MODE" ] && { echo "usage: DAoCLauncher wine <wine-args...>" >&2; exit 1; }
shift

if [ "$MODE" = "wine" ]; then
    # 'd3d9,dxgi=b': the wine build's own d3d9 (mtld3d, picked by its compatdb).
    # DAOC_DLL_OVERRIDES replaces this; WINE_COMPATDB (passed through) can
    # select another renderer, e.g. $'v=5\nname=daoc;exe=game.dll;d3d9=wined3d'.
    # `daoc graphics`'s anisotropy patch matches the next line character for
    # character (daoc_gfx/anisotropy.py STOCK_LINE) and rewrites it in
    # dist/DAoCLauncher.app; `daoc graphics update` checks the two still agree.
    export WINEDLLOVERRIDES="${DAOC_DLL_OVERRIDES:-d3d9,dxgi=b}"
    export WINEPREFIX="${DAOC_WINEPREFIX:-$INSTALL_DIR/dist/prefix}"
    cd "$CLIENT_ROOT/runtime/client-opendaoc/app"
    # The arm64 Wine (Hadron's runtime, recognised by lib/wine/aarch64-unix as
    # in daoc_cli.checkout.wine_is_arm64) opens FreeType and its other
    # libraries by name from ext/lib. Set here: SIP strips DYLD_* when this
    # /bin/bash script starts.
    if [ -d "$WINE_HOME/lib/wine/aarch64-unix" ]; then
        export DYLD_FALLBACK_LIBRARY_PATH="$WINE_HOME/ext/lib"
    fi
    # Benchmark probe: DAOC_FTLOG_DIR=<dir> logs one timestamp per presented
    # Metal frame to <dir>/ftlog-<pid>.txt (client/tools/frametime). It has to
    # be injected here: SIP strips DYLD_* when this /bin/bash script starts.
    if [ -n "${DAOC_FTLOG_DIR:-}" ]; then
        export FTLOG_DIR="$DAOC_FTLOG_DIR"
        export DYLD_INSERT_LIBRARIES="$INSTALL_DIR/client/tools/frametime/ftlog.dylib"
    fi
    # DAOC_FPS_OVERLAY=1 shows Apple's Metal Performance HUD (FPS, frame-time
    # graph) in the game window's top-right corner. Needs a Metal renderer
    # (mtld3d); it is not reliable over wined3d's GL path.
    if [ "${DAOC_FPS_OVERLAY:-0}" = 1 ]; then
        export MTL_HUD_ENABLED=1
    fi
    # The GL init under Rosetta crashes probabilistically at two distinct
    # points (measured 2026-10-09): wined3d adapter selection
    # (err:seh:NtRaiseException) and window creation
    # (err:d3d:wined3d_caps_gl_ctx_create "Failed to create a window").
    # Wine's exit status is unreliable for detecting these: the
    # NtRaiseException mode surfaced as status=5, the caps_gl_ctx_create mode
    # as status=0 — the code path through start.exe varies. So the crash
    # decision is made from the LOG SLICE of this launch alone: if it contains
    # either signature and the client died quickly (elapsed < 60 s — a crash
    # never reaches login, which takes 1-2 min), relaunch. A slow exit or a
    # slice without a signature is a real session (/quit or play) — never
    # relaunched. Bounded at 10 tries; traces every exit to
    # /tmp/daoc-launcher.log (stderr from an `open`-launched app is invisible).
    # DAOC_LAUNCHER_RETRIES caps the launch attempts (1 = launch once, never
    # relaunch): `daoc dev e2e` sets it to 1 because it runs its own relaunch
    # loop and two competing relaunchers would double-start clients and
    # desynchronize its attempt accounting.
    status=0
    log=/tmp/daoc-wine.log
    trace=/tmp/daoc-launcher.log
    trace_msg() { echo "$(date '+%H:%M:%S') DAoCLauncher: $*" | tee -a "$trace" >&2; }
    max="${DAOC_LAUNCHER_RETRIES:-10}"
    gave_up=0
    for ((attempt = 1; attempt <= max; attempt++)); do
        status=0
        offset=$(wc -c < "$log" 2>/dev/null | tr -d ' ' || true); offset=${offset:-0}
        start_ts=$(date +%s)
        "$WINE_HOME/bin/wine" "$@" >> "$log" 2>&1 || status=$?
        elapsed=$(( $(date +%s) - start_ts ))
        tail=$(tail -c "+$((offset + 1))" "$log" 2>/dev/null)
        if printf '%s' "$tail" | grep -qE "NtRaiseException|caps_gl_ctx_create.*Failed to create a window|virtual_setup_exception"; then
            crashed=1
        else
            crashed=0
        fi
        trace_msg "wine exit: status=$status elapsed=${elapsed}s crashed=$crashed (attempt $attempt/$max)"
        # Relaunch gate: ANY exit within 20 s of launch is a pre-login crash —
        # the signature sometimes never reaches the log (unflushed stderr; 2
        # of 7 crashes in run 10), and a genuine session never ends that fast
        # (login alone takes 1–2 min). The signature is a tiebreaker only for
        # exits between 20 s and 60 s.
        if [ "$elapsed" -lt 20 ] || { [ "$crashed" -eq 1 ] && [ "$elapsed" -lt 60 ]; }; then
            if [ "$attempt" -lt "$max" ]; then
                trace_msg "client crashed — relaunching"
                # Ensure the previous wineserver tree is fully gone before the
                # next attempt: a lingering wineserver wedges the next launch
                # (observed as status=255/hangs after every crash or kill).
                "$WINE_HOME/bin/wineserver" -k 2>/dev/null || true
                "$WINE_HOME/bin/wineserver" -w 2>/dev/null || true
            else
                gave_up=1
            fi
        else
            break   # real session (clean quit, long play, or external kill) — do not relaunch
        fi
    done
    # Giving up must be visible: a nonzero status, and a trace line (stderr
    # from an `open`-launched app is invisible).
    if [ "$gave_up" -eq 1 ]; then
        trace_msg "client crashed $max launches in a row — giving up"
        exit 1
    fi
    exit "$status"
fi

echo "DAoCLauncher: unknown mode '$MODE' (supported: wine)" >&2
exit 1