#!/bin/bash
# DAoCLauncher — runs the DAoC client inside the GUI (Aqua) login session, so the
# game window appears on the desktop instead of inside a terminal's context.
#
#   DAoCLauncher wine <wine-args...>
#
# The 'wine' mode is the proven working configuration: wined3d GL renderer with
# the bundled d3d9/dxgi overrides. The install sets the WINEPREFIX and client
# directory up; this wrapper only wires the environment and execs wine.
set -euo pipefail
INSTALL_DIR="$(cd "$(dirname "$0")/../../../.." && pwd)"   # .../daoc-macos (bundle sits in dist/)
CLIENT_ROOT="$INSTALL_DIR/dist/OfflineDAoC"
WINE_APP="$INSTALL_DIR/dist/wine/Wine Staging.app"

MODE="${1:-}"
[ -z "$MODE" ] && { echo "usage: DAoCLauncher wine <wine-args...>" >&2; exit 1; }
shift

if [ "$MODE" = "wine" ]; then
    export WINEDLLOVERRIDES='d3d9,dxgi=b'
    export WINEPREFIX="$INSTALL_DIR/dist/prefix"
    cd "$CLIENT_ROOT/runtime/client-opendaoc/app"
    # The GL init under Rosetta crashes probabilistically at two distinct
    # points (measured 2026-10-09): wined3d adapter selection
    # (err:seh:NtRaiseException) and window creation
    # (err:d3d:wined3d_caps_gl_ctx_create "Failed to create a window").
    # Wine's exit status is unreliable for detecting these: the
    # NtRaiseException mode surfaced as status=5, the caps_gl_ctx_create mode
    # as status=0 — the code path through start.exe varies. So the crash
    # decision is made from the LOG SLICE of this launch alone: if it contains
    # either signature and the client died quickly (elapsed < 60 s — a crash
    # never reaches login, which takes 1-2 min), relaunch. A slow exit or a
    # slice without a signature is a real session (/quit or play) — never
    # relaunched. Bounded at 10 tries; traces every exit to
    # /tmp/daoc-launcher.log (stderr from an `open`-launched app is invisible).
    # DAOC_LAUNCHER_RETRIES caps the launch attempts (1 = launch once, never
    # relaunch): e2e-test.sh sets it to 1 because it runs its own relaunch
    # loop and two competing relaunchers would double-start clients and
    # desynchronize its attempt accounting.
    status=0
    log=/tmp/daoc-wine.log
    trace=/tmp/daoc-launcher.log
    trace_msg() { echo "$(date '+%H:%M:%S') DAoCLauncher: $*" | tee -a "$trace" >&2; }
    max="${DAOC_LAUNCHER_RETRIES:-10}"
    gave_up=0
    for ((attempt = 1; attempt <= max; attempt++)); do
        status=0
        offset=$(wc -c < "$log" 2>/dev/null | tr -d ' '); offset=${offset:-0}
        start_ts=$(date +%s)
        "$WINE_APP/Contents/Resources/wine/bin/wine" "$@" >> "$log" 2>&1 || status=$?
        elapsed=$(( $(date +%s) - start_ts ))
        tail=$(tail -c "+$((offset + 1))" "$log" 2>/dev/null)
        if printf '%s' "$tail" | grep -qE "NtRaiseException|caps_gl_ctx_create.*Failed to create a window"; then
            crashed=1
        else
            crashed=0
        fi
        trace_msg "wine exit: status=$status elapsed=${elapsed}s crashed=$crashed (attempt $attempt/$max)"
        # Relaunch gate: ANY exit within 20 s of launch is a pre-login crash —
        # the signature sometimes never reaches the log (unflushed stderr; 2
        # of 7 crashes in run 10), and a genuine session never ends that fast
        # (login alone takes 1–2 min). The signature is a tiebreaker only for
        # exits between 20 s and 60 s.
        if [ "$elapsed" -lt 20 ] || { [ "$crashed" -eq 1 ] && [ "$elapsed" -lt 60 ]; }; then
            if [ "$attempt" -lt "$max" ]; then
                trace_msg "client crashed — relaunching"
                sleep 3
            else
                gave_up=1
            fi
        else
            break   # real session (clean quit, long play, or external kill) — do not relaunch
        fi
    done
    # Giving up must be visible: a nonzero status, and a trace line (stderr
    # from an `open`-launched app is invisible).
    if [ "$gave_up" -eq 1 ]; then
        trace_msg "client crashed $max launches in a row — giving up"
        exit 1
    fi
    exit "$status"
fi

echo "DAoCLauncher: unknown mode '$MODE' (supported: wine)" >&2
exit 1